/**
 * @fileoverview Firestore Security Rules for the Forex Signal Website.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, with "user" and "admin" roles.
 * Users can only read/write their own data. Admins have broad access. Signals are split between
 * free (publicly readable) and pro (requiring premium membership).
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /signals_free/{signalId}: Stores publicly accessible forex signals.
 * - /signals_pro/{signalId}: Stores premium forex signals.
 * - /upgrade_requests/{upgradeRequestId}: Stores user upgrade requests.
 *
 * Key Security Decisions:
 * - User listing is denied to non-admins.
 * - Signals are segregated into free and pro collections for simpler read rules.
 * - Data shape validation is relaxed for rapid prototyping but critical authorization fields are validated.
 *
 * Denormalization for Authorization:
 * The `role` field is denormalized into the user document for simpler authorization checks.
 * The `status` (free/premium) is part of the signal documents themselves which are stored
 * in seperate `signals_free` and `signals_pro` collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to user documents based on ownership.
     * @path /databases/{database}/documents/users/{userId}
     * @allow (get, update, delete) User with matching UID can access their own document. (create) User can create their own document
     * @deny (get, update, delete) User cannot access another user's document. (create) User cannot create a document with a mismatched UID.
     * @principle Enforces user-ownership for data access.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants read access to all signals and restricts write access to admins only.
     * @path /databases/{database}/documents/signals_free/{signalId}
     * @allow (get, list) Any authenticated user can read free signals.
     * @deny (create, update, delete) Only admin can perform write operations.
     * @principle Public read, restricted write.
     */
    match /signals_free/{signalId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
          return request.auth.token.role == 'admin';
      }

      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Grants read access to pro and admin users only to premium signals and restricts write access to admins only.
     * @path /databases/{database}/documents/signals_pro/{signalId}
     * @allow (get, list) Pro and admin user can read premium signals.
     * @deny (create, update, delete) Only admin can perform write operations.
     * @principle Role-based read access and restricted write.
     */
    match /signals_pro/{signalId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
          return request.auth.token.role == 'admin';
      }

      function isPro() {
        return request.auth.token.role == 'pro';
      }

      allow get, list: if isSignedIn() && (isAdmin() || isPro());
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Grants users the ability to create upgrade requests. Admin can read them.
     * @path /databases/{database}/documents/upgrade_requests/{upgradeRequestId}
     * @allow (create) Authenticated user can create upgrade requests.
     * @allow (get, list) Admins can read upgrade requests.
     * @deny (update, delete) Only creation and admin reads allowed.
     * @principle User-generated content with admin oversight.
     */
    match /upgrade_requests/{upgradeRequestId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function isAdmin() {
            return request.auth.token.role == 'admin';
        }

        allow get, list: if isSignedIn() && isAdmin();
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
    }
  }
}