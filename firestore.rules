
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if a user is an admin
    function isAdmin() {
      // Check if the requesting user's document in the 'users' collection has the role 'admin'.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // READ:
      // - A user can read their own profile.
      // - An admin can read any user's profile.
      allow read: if request.auth.uid == userId || isAdmin();

      // CREATE:
      // - Any authenticated user can create their own user profile upon signup.
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // UPDATE:
      // - A user can update their own profile (but not their role).
      // - An admin can update ONLY the 'role' of any user.
      allow update: if (request.auth.uid == userId && !("role" in request.resource.data)) || (isAdmin() && request.resource.data.keys().hasOnly(["role", "fullName", "email", "createdAt"]));

      // DELETE:
      // - Only an admin can delete a user record.
      allow delete: if isAdmin();
    }

    // LIST (for collections):
    // - An admin can list all users.
    match /users/{document=**} {
      allow list: if isAdmin();
    }
    
    // Rules for the 'signals' collection
    match /signals/{signalId} {
      // READ/LIST:
      // - Any authenticated user can read or list signals.
      // - The UI will handle which signals to show based on user role.
      allow read, list: if request.auth != null;
      
      // CREATE, UPDATE, DELETE:
      // - Only an admin can create, update, or delete signals.
      allow write: if isAdmin();
    }
  }
}
