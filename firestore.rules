/**
 * @fileoverview Firestore Security Rules for Trader Choice application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles,
 * admin-only writes for signals, and user-ownership for payments. It prioritizes
 * secure access control while allowing flexible data structures during prototyping.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles. Only the user themselves can
 *   read or write their profile data.
 * - /signals/{signalId}: Stores forex trading signals. Only admins can create,
 *   update, or delete signals. Signals are publicly readable.
 * - /payments/{paymentId}: Stores user payment transactions. Only the user themselves
 *   can create a payment transaction. Admins can update the payment transaction status.
 *
 * Key Security Decisions:
 * - Users can only manage their own profile.
 * - Signals are publicly readable but admin-manageable.
 * - Payments are user-owned.
 * - Data validation is minimal, focusing on relational integrity (e.g., user IDs).
 *
 * Denormalization for Authorization:
 *  N/A - No denormalization is used in this rule set.
 *
 * Structural Segregation:
 * N/A - No structural segregation is used in this rule set.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile data.
     * @path /databases/{database}/documents/users/{userId}
     * @allow (get, create, update, delete) if the request is made by the user with matching {userId}.
     *   Example: A user with UID "user123" can read/write the document at /users/user123.
     * @deny (get, create, update, delete) if the request is made by a different user.
     *   Example: A user with UID "user456" cannot read/write the document at /users/user123.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages forex trading signals. Signals are publicly readable but admin-manageable.
     * @path /databases/{database}/documents/signals/{signalId}
     * @allow (get, list) to all users.
     *   Example: Any user can read the signal at /signals/signal123.
     * @allow (create, update, delete) only to admin users.
     *   Example: An admin user can create, update, or delete the signal at /signals/signal123.
     * @deny (create, update, delete) to non-admin users.
     *   Example: A regular user cannot create, update, or delete the signal at /signals/signal123.
     * @principle Allows public read access with owner-only (admin) writes.
     */
    match /signals/{signalId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages user payment transactions. Users can create payments. Admins can update the status.
     * @path /databases/{database}/documents/payments/{paymentId}
     * @allow (create) if the request is made by the user with matching uid in payment data.
     *   Example: A user with UID "user123" can create a payment at /payments/payment123 if payment.uid == "user123".
     * @allow (update) if the request is made by an admin user.
     *   Example: An admin user can update the payment status at /payments/payment123.
     * @deny (get, list, delete) to all users.
     *   Example: A regular user cannot read, list, or delete payments.
     * @principle Enforces user-ownership for creation and admin-only updates.
     */
    match /payments/{paymentId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() && resource != null;
      allow delete: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
  }

  function isAdmin() {
    return request.auth.token.role == 'admin';
  }
}