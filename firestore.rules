
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // By default, deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow users to read and write to their own user document
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      // Allow admins to read and write to any user document
      allow read, write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Allow authenticated users to create their own user document during sign-up
    match /users/{userId} {
       allow create: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to read signals
    match /signals/{signalId} {
      allow read: if request.auth != null;
      // Only allow admins to create, update, or delete signals
      allow create, update, delete: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
