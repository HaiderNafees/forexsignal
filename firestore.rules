rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to get the role of the requesting user
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    // Function to check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null && getUserRole(request.auth.uid) == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // ANY authenticated user can create their own user document upon signup
      allow create: if request.auth != null;

      // A user can read their own document. Admins can read any document.
      allow get: if request.auth.uid == userId || isAdmin();
      
      // Admins can list all users. Regular users cannot.
      allow list: if isAdmin();

      // A user can update their own document. Admins can update any user's role.
      allow update: if request.auth.uid == userId || 
                       (isAdmin() && 'role' in request.resource.data);
                       
      // Only admins can delete users (but not themselves).
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // Rules for the 'signals' collection
    match /signals/{signalId} {
      // Any authenticated user can read signals.
      allow get, list: if request.auth != null;
      
      // Only admins can create, update, or delete signals.
      allow create, update, delete: if isAdmin();
    }
  }
}
