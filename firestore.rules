/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and allows public read access to trading signals while restricting write access to authorized users. Upgrade requests can be created by any logged-in user.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles.
 * - /signals/{signalId}: Stores trading signals.
 * - /upgrade_requests/{requestId}: Logs user upgrade requests.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Trading signals are publicly readable but only modifiable by authorized users (no specific authorization is defined in the prompt).
 * - Users can create upgrade requests, but cannot list or read existing ones.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (get, list) User A can read their own profile data.
     * @allow (create, update, delete) User A can create, update, and delete their own profile data.
     * @deny (get, list) User A cannot read User B's profile data.
     * @deny (create, update, delete) User A cannot modify User B's profile data.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to trading signals. Signals are publicly readable, but only authorized users can create, update, or delete them.
     * @path /signals/{signalId}
     * @allow (get, list) Any user can read trading signals.
     * @deny (create, update, delete) Only authorized users can modify trading signals. The auth implementation needs to be defined.
     * @principle Allows public read access while restricting write access.
     */
    match /signals/{signalId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      // CRITICAL: Cannot implement owner-only writes. No ownership field is defined in the entity.
    }

     /**
      * @description Controls access to upgrade requests. Any authenticated user can create an upgrade request. Listing or retrieving upgrade requests is not allowed.
      * @path /upgrade_requests/{requestId}
      * @allow (create) Any authenticated user can create an upgrade request.
      * @deny (get, list, update, delete) No user can get, list, update, or delete upgrade requests.
      */
    match /upgrade_requests/{requestId} {
        allow create: if isSignedIn();
        allow get, list, update, delete: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isSignedIn() && isOwner(userId) && resource != null;
    }
  }
}