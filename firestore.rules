rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Any authenticated user can create their own user document.
      allow create: if isAuth();
      // A user can read their own document. Admins can read any user document.
      allow get: if isUser(userId) || isAdmin();
      // A user can only update their own document. Admins cannot directly update user docs (must use cloud function).
      allow update: if isUser(userId);
      // Only admins can delete user documents (except their own).
      allow delete: if isAdmin() && request.auth.uid != userId;
      // Admins can list all users.
      allow list: if isAdmin();
    }

    // Rules for the 'signals' collection
    match /signals/{signalId} {
      // Any authenticated user can view signals.
      allow read: if isAuth();
      // Only admins can create, update, or delete signals.
      allow write: if isAdmin();
    }
  }
}
