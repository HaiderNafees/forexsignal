/**
 * @file Firestore Security Rules for ForexEdge Application
 * @description This ruleset enforces a role-based access control model, primarily distinguishing between 'free', 'pro', and 'admin' users. It uses structural segregation to isolate free and pro signals into separate collections, and employs ownership checks for user profiles.
 * @dataStructure
 *   - /users/{userId}: Stores user profiles, with 'userId' matching the authenticated user's UID.
 *   - /roles_admin/{userId}: Presence of a document grants admin privileges to the corresponding user.
 *   - /signals_free/{signalId}: Contains signals accessible to all users.
 *   - /signals_pro/{signalId}: Contains signals accessible only to 'pro' users.
 * @keySecurityDecisions
 *   - User listing is disallowed to protect user privacy.
 *   - Admin privileges are granted based on the existence of a document in `/roles_admin/{userId}`.
 *   - Public read access is granted to `/signals_free/{signalId}`.
 * @denormalizationForAuthorization
 *   - The user's role is stored directly within the user document in `/users/{userId}` to simplify authorization checks without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-level access control for user profiles.
     * @path /users/{userId}
     * @allow (get) Signed-in user can read their own profile.
     * @allow (create) Signed-in user can create their own profile.
     * @allow (update) Signed-in user can update their own profile.
     * @deny (get) Signed-in user cannot read other user profiles.
     * @deny (create) Signed-in user cannot create profile with mismatched userId.
     * @deny (update) Signed-in user cannot update other user profiles.
     * @principle Enforces document ownership for reads and writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Controls access to admin roles. The presence of a document in this collection grants admin rights.
     * @path /roles_admin/{userId}
     * @allow (get) Admin can check if a user is an admin.
     * @allow (create) Only an admin can grant admin role to a user.
     * @allow (delete) Only an admin can revoke admin role from a user.
     * @deny (get) Non-admin user cannot check admin status.
     * @deny (create) Non-admin user cannot grant admin role.
     * @deny (delete) Non-admin user cannot revoke admin role.
     * @principle Enforces role-based access control for granting admin privileges.
     */
    match /roles_admin/{userId} {
        function isAdmin() {
            return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
        }
        function isSignedIn() {
            return request.auth != null;
        }
        allow get: if isSignedIn() && isAdmin();
        allow list: if false;
        allow create: if isSignedIn() && isAdmin();
        allow update: if false;
        allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Allows public read access to free signals, with no write access.
     * @path /signals_free/{signalId}
     * @allow (get) All users can read free signals.
     * @allow (list) All users can list free signals.
     * @deny (create) No one can create free signals through client-side rules.
     * @deny (update) No one can update free signals through client-side rules.
     * @deny (delete) No one can delete free signals through client-side rules.
     * @principle Allows public read access while restricting write access.
     */
    match /signals_free/{signalId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Restricts access to pro signals to 'pro' users only.
     * @path /signals_pro/{signalId}
     * @allow (get) Pro users can read pro signals.
     * @allow (list) Pro users can list pro signals.
     * @deny (get) Non-pro users cannot read pro signals.
     * @deny (create) No one can create pro signals through client-side rules.
     * @deny (update) No one can update pro signals through client-side rules.
     * @deny (delete) No one can delete pro signals through client-side rules.
     * @principle Enforces role-based access control for premium content.
     */
    match /signals_pro/{signalId} {
        function isPro() {
            return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pro';
        }
        function isSignedIn() {
            return request.auth != null;
        }
        allow get: if isSignedIn() && isPro();
        allow list: if isSignedIn() && isPro();
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }
  }
}