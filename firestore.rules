/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and payment information,
 *              while allowing public read access to forex signals. Administrative privileges are required
 *              to create, update, or delete signals.
 *
 * @dataStructure
 * - /users/{userId}: Stores individual user profiles. Access is restricted to the owning user.
 * - /signals/{signalId}: Stores forex trading signals. Publicly readable, but only admins can modify.
 * - /payments/{paymentId}: Stores payment records. Accessible only to the owning user.
 *
 * @keySecurityDecisions
 * - User listing is disallowed to protect user privacy.
 * - Signals are publicly readable to maximize app utility, but creating/modifying them is admin-restricted.
 * - Payment records are strictly user-owned to prevent unauthorized access to financial data.
 *
 * @denormalizationForAuthorization
 * - Signals: `createdBy` field stores the UID of the admin who created the signal, facilitating admin-only write rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for user profiles.  Only the authenticated user can read or write their own profile.
     * @path /databases/{database}/documents/users/{userId}
     * @allow (create) - User with UID 'user_abc' can create their profile at /users/user_abc
     * @allow (get, update, delete) - User with UID 'user_abc' can read, update, and delete their profile at /users/user_abc
     * @deny (create, get, update, delete) - User with UID 'user_xyz' cannot access the profile at /users/user_abc
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // User listing is not allowed.
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows public read access to signals, but restricts creation, updates, and deletion to admins.
     * @path /databases/{database}/documents/signals/{signalId}
     * @allow (get, list) - Any user (signed in or not) can read signals.
     * @allow (create) - Admin user with 'admin' role can create signals.
     * @deny (create) - Non-admin user cannot create signals.
     * @allow (update, delete) - Admin user with 'admin' role can update/delete signals.
     * @deny (update, delete) - Non-admin user cannot update/delete signals.
     * @principle Enforces role-based access control for writes.
     */
    match /signals/{signalId} {
       function isAdmin() {
          return request.auth.token.role == 'admin';
        }

      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Enforces user-ownership for payment records.  Only the authenticated user can read or write their own payment data.
     * @path /databases/{database}/documents/payments/{paymentId}
     * @allow (create) - User with UID 'user_abc' can create their payment record.
     * @allow (get, update, delete) - User with UID 'user_abc' can read, update, and delete their payment record.
     * @deny (create, get, update, delete) - User with UID 'user_xyz' cannot access the payment record of 'user_abc'.
     * @principle Enforces document ownership for all operations.
     */
    match /payments/{paymentId} {
       function isOwner() {
        return request.auth.uid == resource.data.userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner();
      allow list: if false; // User listing is not allowed.
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }
  }
}