/**
 * @fileOverview Firestore Security Rules for the ForexEdge application.
 *
 * Core Philosophy:
 * This ruleset enforces role-based access control. Users have roles (free, pro, admin).
 * User data is protected via ownership. Free signals are publicly readable, while pro signals are restricted to pro users and admins.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, with 'userId' matching the Firebase Authentication UID.
 * - /roles_admin/{userId}: Presence of a document grants admin rights to the user.
 * - /signals_free/{signalId}: Stores free signals, publicly readable.
 * - /signals_pro/{signalId}: Stores pro signals, accessible only to pro users and admins.
 *
 * Key Security Decisions:
 * - User listing is disabled.
 * - Admin status is determined by the existence of a document in /roles_admin/{userId}.
 * - Roles are denormalized onto the user document itself for efficient access control.
 * - No data type validation is performed in this prototype, except for authorization-critical fields.
 *
 * Denormalization for Authorization:
 * - The user's role is stored directly in the /users/{userId} document to avoid needing to query a separate roles collection.
 *
 * Structural Segregation:
 * - Signals are split into two collections (/signals_free and /signals_pro) based on their access level. This avoids the need for filtering rules and improves security for `list` operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces access control for user profiles. Only the authenticated user can read/write their own profile.
     * @path /users/{userId}
     * @allow (create) User with UID 'user_abc' can create their own profile.
     * @allow (get, update, delete) User with UID 'user_abc' can read/write their own profile.
     * @deny (create, get, update, delete) User with UID 'user_xyz' cannot access profile 'user_abc'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId);
      }

      allow get: if isOwner(userId);
      allow list: if false; // User listing is not allowed.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.id == request.auth.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls admin role assignment. Only an admin can create/delete admin role assignments.
     *              Read access is allowed for all authenticated users.
     * @path /roles_admin/{userId}
     * @allow (create, delete) Admin can create/delete admin roles.
     * @allow (get) Authenticated user can check if a user is an admin.
     * @deny (create, delete) Non-admin cannot assign admin roles.
     * @principle Enforces role-based access control for admin privileges.
     */
    match /roles_admin/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get: if isSignedIn();
      allow list: if false; // Admin role listing is not allowed.

      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    /**
     * @description Allows public read access to free signals, but restricts creation, updates, and deletion to admins only.
     * @path /signals_free/{signalId}
     * @allow (get, list) All users can read free signals.
     * @allow (create, update, delete) Only admins can modify free signals.
     * @deny (create, update, delete) Non-admins cannot modify free signals.
     * @principle Allows public read access with restricted write access based on role.
     */
    match /signals_free/{signalId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Restricts access to pro signals to pro users and admins only.
     * @path /signals_pro/{signalId}
     * @allow (get, list) Pro users and admins can read pro signals.
     * @allow (create, update, delete) Only admins can create/modify pro signals.
     * @deny (get, list) Free users cannot read pro signals.
     * @deny (create, update, delete) Non-admins cannot modify pro signals.
     * @principle Enforces role-based access control for premium content.
     */
    match /signals_pro/{signalId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      function isProUser() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pro';
      }

      allow get: if isSignedIn() && (isAdmin() || isProUser());
      allow list: if isSignedIn() && (isAdmin() || isProUser());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}