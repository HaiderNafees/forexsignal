/**
 * @fileoverview Firestore Security Rules for the TraderChoice application.
 *
 * Core Philosophy:
 * This ruleset defaults to a secure, deny-all policy.  It requires authentication for nearly all data access and enforces strict ownership for user-specific data.
 * Where public access is permitted (e.g., public profiles), it is carefully controlled and clearly documented.  Data validation is relaxed to enable rapid prototyping, but authorization checks are robust.
 *
 * Data Structure:
 * The Firestore database has no clearly defined structure (no entities are described).
 *
 * Key Security Decisions:
 * - All read and write access is initially denied unless explicitly allowed by the rules.
 * - No data validation is performed beyond authorization checks to allow flexible data shapes during prototyping.
 *
 * Denormalization for Authorization:
 * - In the absence of a clear data model, no denormalization strategies can be applied yet.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if the authenticated user's UID matches the provided userId.
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper function to check if the authenticated user is the existing owner of a document.
    function isExistingOwner(userId) {
      return isOwner(userId);
    }

    // Secure default:  No access unless explicitly allowed.
    match /{path=**} {
       allow read: if false;
       allow write: if false;
    }

    // Example: Allow read access to a specific document for authenticated users.
    // match /users/{userId} {
    //   allow read: if isSignedIn();
    //   allow write: if isOwner(userId);
    // }
  }
}