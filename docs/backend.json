
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user of the Trader Choice application.",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier from Firebase Auth." },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "proExpires": { "type": ["string", "null"], "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Signal": {
      "title": "Signal",
      "type": "object",
      "description": "Represents a forex trading signal.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "entryPrice": { "type": "number" },
        "takeProfit": { "type": "number" },
        "stopLoss": { "type": "number" },
        "isPremium": { "type": "boolean" },
        "createdBy": { "type": "string", "description": "UID of the admin who created it." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "entryPrice", "takeProfit", "stopLoss", "isPremium", "createdBy", "createdAt"]
    },
    "Payment": {
      "title": "Payment",
      "type": "object",
      "description": "Represents a user's payment transaction.",
      "properties": {
        "uid": { "type": "string" },
        "txHash": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "verifiedAt": { "type": ["string", "null"], "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "txHash", "amount", "status", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password"],
    "customClaims": {
      "role": {
        "type": "string",
        "enum": ["user", "admin"]
      },
      "pro": {
        "type": "boolean"
      }
    }
  },
  "firestore": {
    "collections": {
      "users": {
        "schema": { "$ref": "#/entities/User" },
        "description": "Stores user profile information, keyed by Firebase Auth UID."
      },
      "signals": {
        "schema": { "$ref": "#/entities/Signal" },
        "description": "Stores all forex signals, both free and premium."
      },
      "payments": {
        "schema": { "$ref": "#/entities/Payment" },
        "description": "Stores user payment transaction hashes for verification."
      }
    }
  }
}
